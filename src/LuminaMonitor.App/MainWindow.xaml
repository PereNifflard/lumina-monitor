<Window x:Class="LuminaMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumina Monitor" Height="1180" Width="570" MinHeight="420" MinWidth="240"
        Background="{StaticResource Surface}" Foreground="{StaticResource OnSurface}"
        FontFamily="{StaticResource BodyFont}" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <!-- Aucun texte d'interface ici : libelles, infobulles et bandeaux sont
         poses par ApplyTexts, depuis Texts (anglais ou francais). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================= Barre du haut ===
             64 px dans la charte ; 44 ici, parce que chaque pixel pris en haut
             est un pixel de telephone en moins et que la fenetre est deja aussi
             haute que l'ecran le permet. -->
        <Grid Grid.Row="0" Margin="16,10,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Lumina Monitor"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource OnSurface}"
                       VerticalAlignment="Center" />

            <!-- Outline, pas OutlineVariant : celui-ci est fait pour des traits,
                 et a #404752 sur un fond #131313 la phrase se devinait plus
                 qu'elle ne se lisait. -->
            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="18,0,14,0"
                       FontSize="11.5" VerticalAlignment="Center"
                       Foreground="{StaticResource Outline}"
                       TextTrimming="CharacterEllipsis" />

            <!-- Pastille de connexion : verre a 10 %, point vert qui bat. -->
            <Border Grid.Column="2" CornerRadius="999" Padding="10,4"
                    Background="{StaticResource GlassSurface}"
                    BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StateDot" Width="7" Height="7"
                             Fill="{StaticResource Error}" VerticalAlignment="Center">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1.0" To="0.35" Duration="0:0:1.1"
                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock x:Name="StateText" Margin="8,0,0,0"
                               FontSize="12" FontWeight="Medium"
                               Foreground="#CCE5E2E1" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Button Grid.Column="3" x:Name="MetricsButton" Style="{StaticResource IconButton}"
                    Click="OnMetricsClicked" Margin="6,0,0,0"
                    Content="&#xE9D9;"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" />
        </Grid>

        <!-- ==================================================== Le telephone ===
             Marges serrees : le chassis touche presque le bord de la fenetre. -->
        <Grid x:Name="Stage" Grid.Row="1" Margin="8,4,8,8" Focusable="True"
              Background="Transparent" SizeChanged="OnStageSizeChanged">

            <!-- Pas de taches ambiantes ici, et c'est un choix.
                 La charte les met dans les marges exterieures, autour d'un
                 telephone centre sur un large fond. Cette fenetre n'a que 8 px
                 de marge : les taches n'y avaient nulle part ou exister et
                 ressortaient en fins eclats bleus le long des bords, ce qui se
                 lit comme un defaut d'affichage plutot que comme du decor.
                 L'ombre portee teintee de bleu, juste en dessous, rend la meme
                 idee — la lumiere que l'ecran emet — et tient dans la marge. -->

            <!-- Le chassis. Aucune de ces cotes n'est ecrite ici : elles sont
                 toutes posees par ShapeDevice, en proportion de l'image recue. -->
            <Grid x:Name="Device" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- 1. L'ombre. Silhouette vide, mise en cache : son sous-arbre
                        ne changeant jamais, WPF ne la recalcule jamais. La
                        charte veut une ombre teintee de bleu, comme si l'ecran
                        emettait de la lumiere. -->
                <Border x:Name="Shadow" Background="#000000" CacheMode="BitmapCache">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="60" ShadowDepth="16" Direction="270"
                                          Opacity="0.75" Color="#5C7FB8" />
                    </Border.Effect>
                </Border>

                <!-- 2. Le rail. Un degrade fige, pas un effet. -->
                <Border x:Name="Rail" />

                <!-- 3. Les boutons. Positions relevees sur photo. -->
                <Rectangle x:Name="BtnAction" HorizontalAlignment="Left"  VerticalAlignment="Top" />
                <Rectangle x:Name="BtnVolUp"  HorizontalAlignment="Left"  VerticalAlignment="Top" />
                <Rectangle x:Name="BtnVolDn"  HorizontalAlignment="Left"  VerticalAlignment="Top" />
                <Rectangle x:Name="BtnSide"   HorizontalAlignment="Right" VerticalAlignment="Top" />
                <Rectangle x:Name="BtnCamera" HorizontalAlignment="Right" VerticalAlignment="Top" />

                <!-- 3 bis. Les cibles du clic. La lamelle visible d'un bouton
                     fait une fraction de millimetre de large : cliquable en
                     theorie, introuvable a la souris. Ces jumelles portent le
                     clic, larges comme la lamelle et la tranche de metal qui
                     la porte, posees par ShapeButtons en meme temps que les
                     lamelles. Des Button et non des rectangles : le focus au
                     clavier, Espace et Entree, et un nom pour les lecteurs
                     d'ecran viennent avec. Le style ChassisButton (App.xaml)
                     dit au repos qu'on peut les toucher. -->
                <Button x:Name="HitAction" Style="{StaticResource ChassisButton}"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Click="OnChassisButtonClick" />
                <Button x:Name="HitVolUp"  Style="{StaticResource ChassisButton}"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Click="OnChassisButtonClick" />
                <Button x:Name="HitVolDn"  Style="{StaticResource ChassisButton}"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Click="OnChassisButtonClick" />
                <Button x:Name="HitSide"   Style="{StaticResource ChassisButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnChassisButtonClick" />

                <!-- 4. La bordure de verre noire. Vue de face, les 2,54 mm entre
                        le bord du boitier et le premier pixel ne sont pas tous du
                        metal : un chanfrein clair, puis du noir. -->
                <Border x:Name="Glass" Background="#000000" />

                <!-- 5. L'ecran. Le Clip arrondi est pose une fois par geometrie,
                        jamais par image — un OpacityMask couterait une surface
                        intermediaire a chaque frame. -->
                <Border x:Name="Bezel" Background="#000000">
                    <Grid>
                        <Image x:Name="Screen" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- Curseur predictif : dessine immediatement la ou le
                             pointeur a ete envoye, sans attendre le retour du
                             telephone. C'est ce qui rend le pilotage supportable
                             malgre la latence. -->
                        <Canvas x:Name="Overlay" IsHitTestVisible="False">
                            <Ellipse x:Name="Pointer" Width="15" Height="15"
                                     Visibility="Collapsed">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.38,0.34"
                                                         Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                                        <GradientStop Color="#E8FFFFFF" Offset="0.48" />
                                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Canvas>

                        <Border x:Name="Hint" Background="#D9201F1F" CornerRadius="16"
                                Padding="26,22" HorizontalAlignment="Center"
                                VerticalAlignment="Center" MaxWidth="340"
                                BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
                            <StackPanel>
                                <Image x:Name="HintLogo" Width="56" Height="56"
                                       Source="/assets/lumina-monitor-256.png"
                                       HorizontalAlignment="Center" Margin="0,0,0,16"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="HintTitle"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource OnSurface}" Margin="0,0,0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="1"
                                               Foreground="{StaticResource Primary}"
                                               FontSize="11" FontWeight="Medium" />
                                    <TextBlock x:Name="HintStep1" Grid.Row="0" Grid.Column="1"
                                               Margin="12,0,0,6" FontSize="13"
                                               Foreground="{StaticResource OnSurfaceVariant}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="2"
                                               Foreground="{StaticResource Primary}"
                                               FontSize="11" FontWeight="Medium" />
                                    <TextBlock x:Name="HintStep2" Grid.Row="1" Grid.Column="1"
                                               Margin="12,0,0,6" FontSize="13"
                                               Foreground="{StaticResource OnSurfaceVariant}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="3"
                                               Foreground="{StaticResource Primary}"
                                               FontSize="11" FontWeight="Medium" />
                                    <TextBlock x:Name="HintStep3" Grid.Row="2" Grid.Column="1"
                                               Margin="12,0,0,0" FontSize="13"
                                               Foreground="{StaticResource OnSurfaceVariant}" />
                                </Grid>

                                <TextBlock x:Name="HintNote"
                                           TextWrapping="Wrap" FontSize="11.5" LineHeight="18"
                                           Margin="0,16,0,0" Foreground="{StaticResource OutlineVariant}" />
                            </StackPanel>
                        </Border>

                        <!-- Le bandeau de déverrouillage. Posé sur l'image et
                             non dans la barre d'état : c'est la seule consigne
                             de la session qui demande une main sur le
                             téléphone, et la montée l'attend. -->
                        <Border x:Name="UnlockBanner" Background="#E6402008"
                                CornerRadius="12" Padding="18,12"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Margin="0,26,0,0" MaxWidth="360"
                                BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="UnlockBannerText" TextWrapping="Wrap"
                                           FontSize="13" LineHeight="19"
                                           Foreground="{StaticResource OnSurface}" />
                                <!-- Le seul defaut qui se repare d'un clic : le
                                     multiplexeur Apple. Replie le reste du temps. -->
                                <Button x:Name="AppleDevicesButton"
                                        Margin="0,10,0,0" HorizontalAlignment="Left"
                                        Style="{StaticResource BarButton}"
                                        Click="OnAppleDevicesClicked"
                                        Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- L'écran du téléphone est éteint. Ce n'est pas une
                             panne, et le dire vaut mieux que laisser le flux
                             arrêté passer pour une : c'est exactement le moment
                             où l'app avait l'air cassée. -->
                        <Border x:Name="LockBanner" Background="#E6101B2E"
                                CornerRadius="14" Padding="20,16"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="360"
                                BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
                                Visibility="Collapsed"
                                MouseLeftButtonDown="OnBannerDown">
                            <StackPanel>
                                <TextBlock x:Name="LockBannerTitle"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource OnSurface}" />
                                <TextBlock x:Name="LockBannerText" TextWrapping="Wrap"
                                           FontSize="12.5" LineHeight="19" Margin="0,10,0,0"
                                           Foreground="{StaticResource OnSurfaceVariant}" />
                                <Button x:Name="WakeButton"
                                        Margin="0,14,0,0" HorizontalAlignment="Center"
                                        Style="{StaticResource BarButton}"
                                        Click="OnWakeClicked" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 6. La Dynamic Island, posee par-dessus l'image. Le flux
                        contient deja ces pixels en noir ; la pastille les rend
                        nets au lieu de flous. -->
                <Border x:Name="Island" Background="#000000"
                        HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Ellipse x:Name="Lens" HorizontalAlignment="Right">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.34,0.30">
                                <GradientStop Color="#FF2C3B57" Offset="0.0" />
                                <GradientStop Color="#FF101722" Offset="0.55" />
                                <GradientStop Color="#FF05080D" Offset="1.0" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Border>

                <!-- 7. La bulle de decouverte : premier lancement, ou menu
                        systeme. Posee sur l'ecran, pointe vers les boutons de
                        gauche ; ShapeButtons la place et oriente sa fleche.
                        Transparente au clic : le premier clic la chasse et
                        fait quand meme ce qu'il faisait. -->
                <DockPanel x:Name="SideHint" HorizontalAlignment="Left" VerticalAlignment="Top"
                           IsHitTestVisible="False" Visibility="Collapsed" LastChildFill="True">
                    <Path x:Name="SideHintArrow" DockPanel.Dock="Left"
                          Data="M 0,7 L 9,0 L 9,14 Z" Stretch="None"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border x:Name="SideHintCard" Background="#F2201F1F" CornerRadius="12"
                            Padding="14,9,14,10" BorderThickness="1" MaxWidth="230">
                        <TextBlock x:Name="SideHintText" TextWrapping="Wrap"
                                   FontSize="13" FontWeight="Medium" LineHeight="18"
                                   Foreground="{StaticResource OnSurface}" />
                    </Border>
                </DockPanel>
            </Grid>

            <!-- L'etiquette d'un bouton de la tranche, a l'exterieur du
                 chassis. Un Popup parce que la fenetre n'a que 8 px de marge
                 autour du telephone : dedans, l'etiquette n'aurait tenu que
                 sur l'image. Ouvert au survol ou au focus clavier seulement ;
                 ferme, il n'existe pas. -->
            <Popup x:Name="ButtonLabel" AllowsTransparency="True" Placement="Custom"
                   StaysOpen="True" PopupAnimation="Fade" Focusable="False"
                   IsHitTestVisible="False">
                <Border x:Name="ButtonLabelCard" Background="#F2201F1F" CornerRadius="10"
                        Padding="11,6,12,7" BorderThickness="1" Margin="0"
                        TextElement.FontFamily="{StaticResource BodyFont}">
                    <StackPanel>
                        <TextBlock x:Name="ButtonLabelTitle" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource OnSurface}" />
                        <TextBlock x:Name="ButtonLabelDetail" FontSize="11" Margin="0,1,0,0"
                                   Foreground="{StaticResource Outline}" />
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Le panneau de diagnostic, replie par defaut. -->
            <Border x:Name="MetricsPanel" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,14,0,0" CornerRadius="12" Padding="14,10" MaxWidth="400"
                    Background="#F0201F1F" BorderBrush="{StaticResource GlassBorder}"
                    BorderThickness="1" Visibility="Collapsed">
                <TextBlock x:Name="MetricsText" FontFamily="{StaticResource MonoFont}"
                           FontSize="11" TextWrapping="Wrap" LineHeight="18"
                           Foreground="{StaticResource OnSurfaceVariant}" />
            </Border>
        </Grid>

        <!-- ============================================ Barre de commandes ===
             Sous le telephone, jamais dessus. La charte fait flotter une barre
             au-dessus du contenu ; elle y tombait en pleine zone de navigation,
             exactement la ou la main passe. Le verre reste, la position change.

             Deux gestes quotidiens seulement. Le bouton « Reveiller » a disparu
             avec le pont Bluetooth : par le cable, le clavier n'existe qu'une
             fois le miroir ouvert, et le miroir demande deja un telephone
             deverrouille. -->
        <Border Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,14"
                CornerRadius="16" Padding="6,5"
                Background="{StaticResource GlassSurface}"
                BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="HomeButton" Style="{StaticResource BarButton}"
                        Click="OnHomeClicked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontSize="14" VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" />
                        <TextBlock x:Name="HomeLabel" Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Fill="{StaticResource GlassBorder}" Margin="5,8" />

                <!-- Le presse-papiers, dans les deux sens. Deux boutons plutôt
                     qu'un menu : le sens est ce qu'on choisit, et un menu le
                     cacherait derrière un clic de plus. -->
                <Button x:Name="PasteButton" Style="{StaticResource BarButton}"
                        Click="OnPasteClicked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77F;" FontSize="14" VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" />
                        <TextBlock x:Name="PasteLabel" Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="FetchButton" Style="{StaticResource BarButton}"
                        Click="OnFetchClicked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontSize="14" VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" />
                        <TextBlock x:Name="FetchLabel" Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
